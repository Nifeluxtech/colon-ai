<?xml version="1.0" encoding="utf-8"?>
<!-- Colon AI (applicationId ng.nifelux.colonai): the chat shell. Web pages open in the in-chat browser panel
     (a native WebView inside MainActivity); there is no standalone browser screen in this app (Phase 8). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Colon Music (OS Assistant Step 3): play the phone's songs (asked the first time the user says "play ..."),
         and keep playing in the background with the media notification. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 0.20.0 voice mode: the floating "dynamic island" pill and Siri-style overlay over other apps (the user turns
         on "Display over other apps"; without it Colon uses the notification), and the microphone foreground
         service that keeps voice mode listening while Colon is in the background (VoiceService). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Colon.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share-to-Colon (text, links, images) and chat links from other apps; forwards to MainActivity. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Colon.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Not an auto-verified App Link yet: that needs /.well-known/assetlinks.json with the release key. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="chat.apparatus.name.ng" />
            </intent-filter>
        </activity>
        <!-- Colon OS Assistant (Step 1): Colon AI as the default digital assistant app. Long-press Home (ASSIST) or a
             headset voice button (VOICE_COMMAND) opens the chat in hands-free voice mode; forwards to MainActivity. -->
        <activity
            android:name=".AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/assist_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Colon.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Talk to Colon" Quick Settings tile (AssistTile.kt): hands-free voice even where the phone keeps its
             assistant gestures for another app (Infinix XOS keeps the power key for Folax). -->
        <service
            android:name=".AssistTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_colon"
            android:label="@string/assist_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Colon Music (MusicService.kt): Media3 session around Colon's player; notification, lock screen and
             headset controls. -->
        <service
            android:name=".MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- 0.20.0 voice mode in the background (VoiceService.kt): mic, notification, pill. -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- 0.23.0 "Hey Colon" (WakeWordService.kt): opt-in, listens for the wake word with a persistent
             notification and a Stop action; off by default (Settings › Voice). -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
