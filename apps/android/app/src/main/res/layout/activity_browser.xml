<?xml version="1.0" encoding="utf-8"?>
<!-- Colon Browser: address bar, progress, Saga control bar, the active tab's WebView (added in code), bottom bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colon_bg"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/mode_chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/colon_chip"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/mode_manual"
            android:textColor="@color/colon_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_address"
            android:drawablePadding="8dp"
            android:drawableTint="@color/colon_muted"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/colon_text"
            android:textColorHint="@color/colon_muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_refresh"
            app:tint="@color/colon_text" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/colon_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/control_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colon_banner"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/control_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/colon_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_pause"
            style="@style/Colon.BarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause" />

        <Button
            android:id="@+id/btn_control"
            style="@style/Colon.BarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/take_control" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/Colon.BarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- AI mode: Saga drives, the page can't be touched until "Take control" (Phase 10 control modes). -->
        <FrameLayout
            android:id="@+id/ai_shield"
            tools:ignore="UselessParent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colon_shield"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_take_control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:minHeight="48dp"
                android:text="@string/take_control"
                android:textAllCaps="false"
                app:backgroundTint="@color/colon_primary"
                app:cornerRadius="999dp" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/colon_bg"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Colon.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btn_forward"
            style="@style/Colon.IconButton"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/btn_home"
            style="@style/Colon.IconButton"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/tab_count"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_tab_count"
                android:foregroundGravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/colon_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/Colon.IconButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
