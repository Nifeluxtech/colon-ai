<?xml version="1.0" encoding="utf-8"?>
<!-- Colon AI shell. split_box stacks the in-chat browser panel (ChatBrowserPanel, hidden until a page opens), a
     draggable divider and the chat WebView (added in code to web_container). Layout changes only resize these
     views, so switching embedded / split / full never reloads a page. Progress line and offline screen on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:id="@+id/split_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/browser_panel"
            layout="@layout/view_browser_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.42"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/panel_divider"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:background="@color/colon_bg"
            android:contentDescription="@string/panel_divider"
            android:visibility="gone">

            <View
                android:id="@+id/panel_divider_handle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_divider_handle" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/shell_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/colon_primary"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colon_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/colon_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/offline_title"
            android:textColor="#F1F5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offline_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="340dp"
            android:text="@string/offline_text"
            android:textColor="#BCC7E6"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/offline_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:paddingHorizontal="28dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            app:backgroundTint="@color/colon_primary"
            app:cornerRadius="999dp" />
    </LinearLayout>
</FrameLayout>
