<?xml version="1.0" encoding="utf-8"?>
<!-- First-load splash overlay (SplashOverlay.kt): the system splash's navy and centred 288dp icon, plus the
     WhatsApp-style footer, "from" above "Nifelux". The splash is navy in light and dark themes alike (as the
     system splash, windowSplashScreenBackground), so the footer colours are fixed light-on-navy. No custom font. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colon_dark"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="288dp"
        android:layout_height="288dp"
        android:layout_gravity="center"
        android:contentDescription="@string/logo_description"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_icon" />

    <LinearLayout
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_from"
            android:textColor="@color/splash_from"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.04"
            android:text="@string/splash_brand"
            android:textColor="@color/splash_brand"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
