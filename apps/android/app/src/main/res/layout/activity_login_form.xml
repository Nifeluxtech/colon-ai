<?xml version="1.0" encoding="utf-8"?>
<!-- Colon Secured Login (0.11.0): a native form whose values go straight into the phone's Keystore-encrypted vault.
     FLAG_SECURE is set by the activity; autofill services are kept out (importantForAutofill) so nothing typed here
     is offered to another app, and it has no link to any web page or its scripts. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:text="@string/vault_title"
            android:textColor="@color/colon_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_lock" />

        <TextView
            android:id="@+id/login_intro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/vault_intro"
            android:textColor="@color/colon_muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/login_site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/vault_site"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLength="253" />

        <EditText
            android:id="@+id/login_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:hint="@string/vault_user"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress|textNoSuggestions"
            android:maxLength="512" />

        <EditText
            android:id="@+id/login_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:hint="@string/vault_pass"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLength="512" />

        <CheckBox
            android:id="@+id/login_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vault_show" />

        <CheckBox
            android:id="@+id/login_trust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vault_trust" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/vault_trust_hint"
            android:textColor="@color/colon_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/login_cancel"
                style="@style/Colon.BarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/login_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
