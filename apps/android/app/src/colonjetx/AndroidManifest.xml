<?xml version="1.0" encoding="utf-8"?>
<!-- Colon JetX (applicationId ng.nifelux.colonjetx, 0.34.0, Crash Predictor step 2): the betting site and the
     predictor in one split screen. It opens straight into JetxActivity; it is not offered for other apps' links. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 0.38.0: the screen reader's on-device text recognition (ML Kit through Play services, JetxOcr). Play
             services fetches the Latin OCR model at install; the game's pixels never leave the phone. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <activity
            android:name=".JetxActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Colon.Splash.Jetx"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
