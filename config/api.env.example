# Colon API environment (services/api). Copy these into cPanel > Setup Node.js App > Environment variables.
# Never commit real values: this repository is public. Every key here is in the config schema
# (services/api/src/config/defaults.js); scripts/check.js fails if a schema key is missing from this file.
# An empty value means "use the default". [required in production] keys stop the API at boot when unset;
# a non-numeric value in a numeric key also stops it. Full table: config/README.md.

# Runtime (Phase 1)
NODE_ENV=production
PORT=                  # set by Passenger on cPanel; 3000 locally
ALLOWED_ORIGINS=https://chat.apparatus.name.ng,https://browser.apparatus.name.ng,https://admin.apparatus.name.ng

# Database (Phase 1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=               # [required in production]
DB_USER=               # [required in production]
DB_PASSWORD=

# Accounts and security (Phase 2)
APP_SECRET=            # 48+ random characters (32 minimum); encrypts 2FA secrets and stored provider/search keys.
                       # Changing it makes those unreadable: see docs/runbooks/key-rotation.md.
COOKIE_DOMAIN=.apparatus.name.ng
OWNER_EMAIL=           # this email becomes Super Admin when it registers
APP_URL_CHAT=https://chat.apparatus.name.ng
SESSION_DAYS=30
GOOGLE_CLIENT_ID=      # optional: Google sign-in (Google Cloud > OAuth client, Web)

# Email (Phase 2)
BREVO_API_KEY=         # optional until email goes live (verification and reset emails)
MAIL_FROM=no-reply@apparatus.name.ng
MAIL_FROM_NAME=Colon AI

# AI providers (Phase 3; NVIDIA since 0.4.2). A provider is switched on only when its key is set.
# Add at least one, or chat replies with "no_provider". Admin › Models can also store keys (encrypted).
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free; Gemma 4 via the native Gemini API)
GEMINI_BASE_URL=       # default https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemma-4-26b-a4b-it            # Saga's first choice (0.5.2)
GEMINI_FALLBACK_MODEL=gemma-4-31b-it       # "off" to skip
GEMINI_THINKING=minimal                    # Gemma 4: minimal (fast) or high; "off" sends no thinking setting
GEMINI_VISION=1
NVIDIA_API_KEY=        # build.nvidia.com free developer key "nvapi-..."
NVIDIA_BASE_URL=       # default https://integrate.api.nvidia.com/v1
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_DEEPSEEK_THINKING=off               # "on" = hidden reasoning first (slower)
NVIDIA_GEMMA_MODEL=                        # empty = off
NVIDIA_GLM_MODEL=z-ai/glm-5.3-flash
NVIDIA_GLM_REASONING=low                   # low, high, max, or "default" (host default = max)
NVIDIA_MINIMAX_MODEL=minimaxai/minimax-m3.1-flash
GROQ_API_KEY=          # https://console.groq.com/keys (free)
GROQ_BASE_URL=         # default https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION=0          # 1 only if your Groq model reads images
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys (free models end in :free)
OPENROUTER_BASE_URL=   # default https://openrouter.ai/api/v1
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_DEEPSEEK_VISION=0
OPENROUTER_GEMMA_MODEL=google/gemma-4-31b-it:free
OPENROUTER_GEMMA_VISION=1
NATLAS_BASE_URL=       # optional: an OpenAI-compatible host serving N-ATLaS, e.g. https://<your-endpoint>/v1
NATLAS_API_KEY=
NATLAS_MODEL=n-atlas

# Chat limits and uploads (Phase 3). Daily limits count per UTC day. Guests are counted per browser
# (anonymous cookie), with a higher cap per IP because many mobile users share one IP address.
CHAT_DAILY_LIMIT=100
CHAT_GUEST_DAILY_LIMIT=15
CHAT_GUEST_IP_DAILY_LIMIT=300
UPLOAD_DIR=/home/apparatu/colon-uploads    # outside the repository and every web root
UPLOAD_QUOTA_MB=200

# Model router tuning (Phase 3; hedging since 0.4.3). Optional.
AI_HEDGE=2                                 # models asked at once (first to answer wins)
AI_FIRST_TOKEN_TIMEOUT_MS=25000
AI_IDLE_TIMEOUT_MS=30000
AI_MAX_REPLY_MS=180000
AI_MAX_TOKENS=4096
# Developer mode replies can be longer (whole files of code). Optional.
AI_DEVELOPER_MAX_TOKENS=8192

# Benchmark gate (Phase 5, 0.5.2). Optional.
BENCH_GATE=on                              # "off" lets models into routing without a fresh benchmark
BENCH_MAX_AGE_DAYS=30

# Web search for Research mode (Phase 5, 0.5.3). Nothing is required: with no keys the chain is
# DuckDuckGo → Wikipedia. Admin › System › Web search can switch it off, reorder providers and store keys (encrypted).
WEB_SEARCH=on                              # "off" switches web search off until an admin turns it on
BRAVE_SEARCH_API_KEY=                      # optional (Brave Search API free tier)
TAVILY_API_KEY=                            # optional
SEARXNG_URL=                               # optional, e.g. https://searx.example.org (JSON output must be enabled)
SEARXNG_API_KEY=                           # optional bearer token for a private SearXNG

# Safety layer (Phase 5, 0.5.5; docs/decisions/0003-safety-layer.md). Nothing is required: the rule filters run
# on every chat message by default. Admin › Safety switches categories per audience and provider moderation live.
SAFETY=on                                  # "off" switches the rule filters off; child-safety rules always stay on
SAFETY_LOG_TEXT=off                        # off (default) | hash (keyed SHA-256) | excerpt (first 80 characters)
SAFETY_PROVIDER_MODERATION=off             # "on" also asks the moderation endpoint below (needs its key)
SAFETY_MODERATION_URL=                     # default https://api.openai.com/v1/moderations (OpenAI-compatible)
SAFETY_MODERATION_API_KEY=                 # optional
SAFETY_MODERATION_MODEL=omni-moderation-latest
SAFETY_MODERATION_TIMEOUT_MS=3000          # the endpoint is skipped (fail open, logged) when slower or failing
