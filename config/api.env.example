# Colon API environment (services/api). Copy these into cPanel > Setup Node.js App > Environment variables.
# Never commit real values: this repository is public. Every key here is in the config schema
# (services/api/src/config/defaults.js); scripts/check.js fails if a schema key is missing from this file.
# An empty value means "use the default". [required in production] keys stop the API at boot when unset;
# a non-numeric value in a numeric key also stops it. Full table: config/README.md.

# Runtime (Phase 1)
NODE_ENV=production
PORT=                  # set by Passenger on cPanel; 3000 locally
ALLOWED_ORIGINS=https://chat.apparatus.name.ng,https://browser.apparatus.name.ng,https://admin.apparatus.name.ng

# Database (Phase 1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=               # [required in production]
DB_USER=               # [required in production]
DB_PASSWORD=

# Accounts and security (Phase 2)
APP_SECRET=            # 48+ random characters (32 minimum); encrypts 2FA secrets and stored provider/search keys.
                       # Changing it makes those unreadable: see docs/runbooks/key-rotation.md.
COOKIE_DOMAIN=.apparatus.name.ng
OWNER_EMAIL=           # this email becomes Super Admin when it registers
APP_URL_CHAT=https://chat.apparatus.name.ng
SESSION_DAYS=30
GOOGLE_CLIENT_ID=      # optional: Google sign-in (Google Cloud > OAuth client, Web)

# Email (Phase 2)
BREVO_API_KEY=         # optional until email goes live (verification and reset emails)
MAIL_FROM=no-reply@apparatus.name.ng
MAIL_FROM_NAME=Colon AI

# AI providers (Phase 3; NVIDIA since 0.4.2). A provider is switched on only when its key is set.
# Add at least one, or chat replies with "no_provider". Admin › Models can also store keys (encrypted).
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free; Gemma 4 via the native Gemini API)
GEMINI_BASE_URL=       # default https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemma-4-26b-a4b-it            # Saga's first choice (0.5.2)
GEMINI_FALLBACK_MODEL=gemma-4-31b-it       # "off" to skip
GEMINI_THINKING=minimal                    # Gemma 4: minimal (fast) or high; "off" sends no thinking setting
GEMINI_VISION=1
NVIDIA_API_KEY=        # build.nvidia.com free developer key "nvapi-..."
NVIDIA_BASE_URL=       # default https://integrate.api.nvidia.com/v1
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_DEEPSEEK_THINKING=off               # "on" = hidden reasoning first (slower)
NVIDIA_GEMMA_MODEL=                        # empty = off
NVIDIA_GLM_MODEL=z-ai/glm-5.3-flash
NVIDIA_GLM_REASONING=low                   # low, high, max, or "default" (host default = max)
NVIDIA_MINIMAX_MODEL=minimaxai/minimax-m3.1-flash
GROQ_API_KEY=          # https://console.groq.com/keys (free)
GROQ_BASE_URL=         # default https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION=0          # 1 only if your Groq model reads images
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys (free models end in :free)
OPENROUTER_BASE_URL=   # default https://openrouter.ai/api/v1
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_DEEPSEEK_VISION=0
OPENROUTER_GEMMA_MODEL=google/gemma-4-31b-it:free
OPENROUTER_GEMMA_VISION=1
NATLAS_BASE_URL=       # default https://langa.julimer.com/v1 (Langa); any OpenAI-compatible N-ATLaS host works
NATLAS_API_KEY=        # Langa key (free plan 12,500 tokens/month); unset = N-ATLaS off
NATLAS_MODEL=n-atlas
NATLAS_MAX_TOKENS=2048 # output cap the host accepts (Langa: 2048)

# Chat limits and uploads (Phase 3). Daily limits count per UTC day. Guests are counted per browser
# (anonymous cookie), with a higher cap per IP because many mobile users share one IP address.
CHAT_DAILY_LIMIT=100
CHAT_GUEST_DAILY_LIMIT=15
CHAT_GUEST_IP_DAILY_LIMIT=300
# Billing (v0.12.0): off | shadow (record credit use, never block) | enforce (refuse when credits run out)
BILLING_MODE=shadow
BILLING_CREDITS_CHAT=1
BILLING_CREDITS_RESEARCH=3
BILLING_CREDITS_SAGA=2
# v0.17.0: Colon credits per generated image (on top of one of the plan's monthly image credits; 0 = image credits
# only), and per deep research task (reserved when it starts, settled when the report is posted, refunded on failure).
BILLING_CREDITS_IMAGE=0
BILLING_CREDITS_DEEP_RESEARCH=10
# Costs (v0.14.0): AI prices in kobo per 1M tokens as JSON, e.g. {"groq:*":[0,0],"gpt-4o-mini":[24000,96000]}.
# Empty = every model costs 0 (the free tiers in use today); tokens are recorded either way.
AI_MODEL_COSTS=
# Daily AI spend alert in kobo (Admin > Costs warns at 80% and 100%). Display only, nothing is blocked. 0 = off
BILLING_DAILY_SPEND_CAP_MINOR=0
# Memory (v0.15.0): each user turns memory on themselves (off by default). Most tokens of saved memories added to
# one reply (picked by keyword overlap and recency; 0 = none), and the most memories one user can keep.
MEMORY_TOKEN_BUDGET=500
MEMORY_MAX_ITEMS=200
# Jobs and cron (v0.16.0): background jobs live in MySQL (colon_jobs). cPanel cron runs services/api/scripts/cron.js
# every JOBS_CRON_INTERVAL_MIN minutes (command in docs/runbooks/deploy.md, 0.16.0); Admin > Jobs warns when the last
# run is older than 3 x the interval. Each run claims JOBS_BATCH_SIZE jobs at a time and exits within
# JOBS_TIME_LIMIT_MS. A job not finished within JOBS_LEASE_MS can be taken over; a failure is retried after
# JOBS_BACKOFF_MS (doubling) and dead-lettered after JOBS_MAX_ATTEMPTS tries.
JOBS_CRON_INTERVAL_MIN=5
JOBS_BATCH_SIZE=10
JOBS_TIME_LIMIT_MS=50000
JOBS_LEASE_MS=300000
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_MS=60000
JOBS_KEEP_DAYS=14
# on = the API worker also runs the cron work (fallback only; Passenger can idle the worker). Default off.
JOBS_INPROCESS=off
# Secondary trigger POST https://api.apparatus.name.ng/internal/cron/run with header X-Cron-Secret. Empty = off.
# (AfeesHost's ALTCHA can block non-browser clients, so the CLI above is the primary dispatcher.)
CRON_SECRET=
# Tools and media (v0.17.0): image generation through Google AI Studio (needs GEMINI_API_KEY). IMAGE_MODEL is an
# image-capable model id from https://ai.google.dev/gemini-api/docs/models that your key can use (check it in AI
# Studio first). Empty = Gemini images and all image edits off; a model id Google refuses fails gracefully (credits
# refunded). With the Cloudflare keys below, new images still work while IMAGE_MODEL is empty.
IMAGE_MODEL=
IMAGE_TIMEOUT_MS=90000
# Cloudflare Workers AI (v0.17.1): free text-to-image (flux-1-schnell) within Cloudflare's daily free allocation
# (10,000 neurons, resets 00:00 UTC). With CF_ACCOUNT_ID and CF_AI_TOKEN set, new images go to Cloudflare first and
# fall back to Gemini (IMAGE_MODEL) on any error, including the daily limit. Edits (an image attached) always use
# IMAGE_MODEL: flux-1-schnell cannot take an input image. IMAGE_PROVIDER: cloudflare | gemini | empty (= cloudflare
# when the two CF_ keys are set, else gemini). CF_AI_TOKEN: a Cloudflare API token with "Workers AI: Read" access.
# The cron env file does not need these (no job makes images).
IMAGE_PROVIDER=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Colon Music (v0.19.0; YouTube since v0.21.0): "play X" plays the phone's songs (Android), else finds the song on
# YouTube and plays it in Colon's own YouTube player. Free key: Google Cloud Console > enable "YouTube Data API v3"
# > Credentials > API key (restrict it to that API). 10,000 units/day; a search costs 100 (answers are cached).
# Empty = "play X" opens the YouTube app instead.
YOUTUBE_API_KEY=
# Deep research (v0.17.0) runs as a background job on the cron (services/api/scripts/cron.js), one bounded step per
# job run: searches (RESEARCH_MAX_QUERIES), pages read (RESEARCH_MAX_PAGES), and the longest step (writing the report,
# RESEARCH_STEP_MS; keep it under JOBS_TIME_LIMIT_MS). The cron env file needs the AI and search keys it uses.
RESEARCH_MAX_QUERIES=4
RESEARCH_MAX_PAGES=8
RESEARCH_STEP_MS=35000
# Payments (v0.13.0): Korapay. Leave the key empty to keep payments off. Webhook URL to set in the Korapay
# dashboard (Settings > API Configuration): https://api.apparatus.name.ng/payments/korapay/webhook
KORAPAY_SECRET_KEY=
KORAPAY_API_URL=https://api.korapay.com/merchant/api/v1
APP_URL_API=https://api.apparatus.name.ng
PAYMENT_PERIOD_DAYS=30
UPLOAD_DIR=/home/apparatu/colon-uploads    # outside the repository and every web root
UPLOAD_QUOTA_MB=200

# Model set (0.10.6). gemma (default) = Saga's chat replies and browser agent use Gemma 4 only: Gemma 4 26B on
# Google AI Studio, Gemma 4 31B only when 26B fails or times out, one at a time (AI_HEDGE, specialist routing and
# the other models are skipped). all = the full routing table below and Admin › Routing. Optional.
AI_MODEL_SET=gemma

# Browser tools (0.11.5): the chat model decides on each turn whether to use this chat's browser (Gemini function
# calling: browse, read_page, stop_browsing), in every mode. It runs on Google AI Studio (GEMINI_API_KEY): first
# CHAT_TOOL_MODEL, then CHAT_TOOL_FALLBACK_MODEL (Gemma 4 supports native function calling there). When both fail,
# the old keyword routing decides and the reply comes from the AI_MODEL_SET chain as before. Optional.
CHAT_BROWSER_TOOLS=on                       # off = keyword routing only (0.11.4 behaviour)
CHAT_TOOL_MODEL=gemini-3.5-flash-lite
CHAT_TOOL_FALLBACK_MODEL=gemma-4-26b-a4b-it # "off" to skip
CHAT_TOOL_TIMEOUT_MS=15000                  # first-token timeout per tool model

# Support models (0.11.0): after Gemma 4 26B -> 31B on Google, AI_MODEL_SET=gemma goes on to these, one at a time, for
# chat replies and Saga's browser decisions alike. Each needs its provider's key (GEMINI_API_KEY, GROQ_API_KEY,
# OPENROUTER_API_KEY). Empty AI_SUPPORT_MODELS = GEMINI_SUPPORT_MODELS, then GROQ_SUPPORT_MODEL, then
# OPENROUTER_SUPPORT_MODEL; "off" = none. Or list them yourself, in order, e.g.
# AI_SUPPORT_MODELS=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b. Optional.
AI_SUPPORT_MODELS=
# Google AI Studio support models (same GEMINI_API_KEY; each model has its own free quota, so a 429 on Gemma does not
# rest these). Comma list, in order; "off" = none. gemini-flash-lite-latest is Google's alias for the newest Flash-Lite
# (it moves with each release). gemini-3.8-flash is stable with no shutdown date (it replaced gemini-2.5-flash in
# 0.11.7; Google retires 2.5 Flash on 1 Dec 2026). gemini-4-hydrogen (0.11.8) is the only free Gemini 4; Argon
# and Carbon are paid-only, so they are not listed. A "not found" / "not available" answer just skips a model for a day.
GEMINI_SUPPORT_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-4-hydrogen
GEMINI_SUPPORT_VISION=1                    # Gemini support models may read images (0 = text only)
GEMINI_SUPPORT_UNAVAILABLE_REST_HOURS=24   # how long a withdrawn Gemini model is skipped
GROQ_SUPPORT_MODEL=openai/gpt-oss-120b      # Groq free: 30 RPM, 1,000 RPD, 8K TPM, 200K TPD per model
OPENROUTER_SUPPORT_MODEL=google/gemma-4-31b-it:free  # OpenRouter free: 20 RPM, 50/day (1,000/day after $10 credits)
GROQ_SUPPORT_MAX_INPUT_TOKENS=5000         # Saga's page snapshot is trimmed to fit Groq's 8K tokens a minute
OPENROUTER_SUPPORT_MAX_INPUT_TOKENS=24000
GROQ_SUPPORT_REASONING=low                 # gpt-oss reasoning_effort: low keeps it quick
AI_RETRY_WAIT_MS=3000                      # a 429 with a Retry-After this short is waited out and retried once

# Model router tuning (Phase 3; hedging since 0.4.3). Optional.
AI_HEDGE=2                                 # models asked at once (first to answer wins)
AI_FIRST_TOKEN_TIMEOUT_MS=25000
AI_IDLE_TIMEOUT_MS=30000
# Voice mode (0.22.1): spoken replies use a brief-answer prompt, no browser tools, no Gemma 4 31B (about 21 s to its
# first token), this output cap and this first-token timeout before the next model takes over. Optional.
CHAT_VOICE_MAX_TOKENS=300
CHAT_VOICE_FIRST_TOKEN_MS=8000
AI_MAX_REPLY_MS=180000
AI_MAX_TOKENS=4096
# Developer mode replies can be longer (whole files of code). Optional.
AI_DEVELOPER_MAX_TOKENS=8192
# Specialist routing (Phase 5, 0.5.10): per task category (code, exams, Hausa, ...) the benchmark winner leads the
# chain; weak models go last. on (default) | off. Admin › Routing can switch it live. Optional.
AI_SPECIALIST_ROUTING=on

# Benchmark gate (Phase 5, 0.5.2). Optional.
BENCH_GATE=on                              # "off" lets models into routing without a fresh benchmark
BENCH_MAX_AGE_DAYS=30

# Web search for Research mode (Phase 5, 0.5.3). Nothing is required: with no keys the chain is
# DuckDuckGo → Wikipedia. Admin › System › Web search can switch it off, reorder providers and store keys (encrypted).
WEB_SEARCH=on                              # "off" switches web search off until an admin turns it on
BRAVE_SEARCH_API_KEY=                      # optional (Brave Search API free tier)
TAVILY_API_KEY=                            # optional
SEARXNG_URL=                               # optional, e.g. https://searx.example.org (JSON output must be enabled)
SEARXNG_API_KEY=                           # optional bearer token for a private SearXNG

# Safety layer (Phase 5, 0.5.5; docs/decisions/0003-safety-layer.md). Nothing is required: the rule filters run
# on every chat message by default. Admin › Safety switches categories per audience and provider moderation live.
SAFETY=on                                  # "off" switches the rule filters off; child-safety rules always stay on
SAFETY_LOG_TEXT=off                        # off (default) | hash (keyed SHA-256) | excerpt (first 80 characters)
SAFETY_PROVIDER_MODERATION=off             # "on" also asks the moderation endpoint below (needs its key)
SAFETY_MODERATION_URL=                     # default https://api.openai.com/v1/moderations (OpenAI-compatible)
SAFETY_MODERATION_API_KEY=                 # optional
SAFETY_MODERATION_MODEL=omni-moderation-latest
SAFETY_MODERATION_TIMEOUT_MS=3000          # the endpoint is skipped (fail open, logged) when slower or failing

# Voice (Phase 6, 0.6.0). Speech to text for the mic button. Naija Speech API (free, NCAIR / N-ATLaS ASR models,
# non-commercial licence, attribution shown in the app) handles Hausa, Igbo, Yoruba and Nigerian English; Gemini
# (GEMINI_API_KEY above) handles Pidgin and "Auto" and is the fallback. With neither key, voice notes still work.
VOICE=on                                   # "off" hides server transcription (browser dictation still works)
NAIJA_SPEECH_API_KEY=                      # Naija Speech key (nlb_...): 120 audio minutes a day free
NAIJA_SPEECH_BASE_URL=                     # default https://asr.naijallm.com/v1
VOICE_GEMINI_MODEL=gemini-3.5-flash-lite   # Gemini model that transcribes audio ("off" to skip)
VOICE_MAX_SECONDS=300                      # longest recording accepted (Naija Speech caps a file at 5 minutes)
VOICE_TTS_PER_MINUTE=7                     # read-aloud requests a minute (the Naija Speech key allows 10 in total)

# Colon Browser server pieces (Phase 8, 0.8.1; docs/phase8-backend-contract.md). Nothing is required.
# Server reader for web light mode (GET /browser/fetch): public http/https pages only (SSRF-guarded), 10 s, 2 MB,
# HTML and plain text, sanitised, robots.txt honoured, 30/min and 500/day per user, 60/min per IP for guests.
BROWSER_READER=on                          # "off" answers 501 not_enabled (the web apps fall back to the app prompt)
BROWSER_READER_GUESTS=on                   # "off" keeps the reader for signed-in users only (guests get 401)
BROWSER_READER_BLOCKLIST=                  # extra hosts to refuse, e.g. bad.example,worse.example (subdomains too)

# Saga browser automation (Phase 9): Saga drives the Android app's browser panel through the bridge (/ws).
# Every action is logged (saga_tasks, saga_actions) and approvals are tapped on the phone; none of these keys can
# switch approvals off.
SAGA_BROWSE=on                             # "off" answers 501 not_enabled (the web reader's AI Browse still works)
SAGA_MAX_STEPS=15                          # most actions per task (Saga then stops and reports what it has)
SAGA_TASK_TIMEOUT_MS=300000                # hard cap on one task
SAGA_MODEL_TIMEOUT_MS=60000                # one Saga decision (model call)
SAGA_STEP_TIMEOUT_MS=20000                 # the phone's answer to one command
SAGA_APPROVAL_TIMEOUT_MS=120000            # the user's consent or approval tap on the phone
SAGA_TASKS_PER_HOUR=20                     # tasks a user may start per hour
SAGA_HANDOFF_TIMEOUT_MS=600000             # Phase 10: the user types a password / code / card and taps Return to AI
SAGA_USER_CONTROL_TIMEOUT_MS=900000        # 0.10.3: the user took the browser (Take control / Pause); then Saga stops
SAGA_SCHEDULES_MAX=10                      # 0.11.0: scheduled browsing checks per user (run on the user's phone)
SAGA_RECONNECT_GRACE_MS=90000              # 0.10.4: a dropped phone socket may reconnect this long; the task goes on
