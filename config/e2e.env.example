# Local end-to-end environment for services/api/tests/e2e/{smoke,admin}.js (MySQL/MariaDB + the mock provider).
# Load it into your shell from services/api:   set -a; . ../../config/e2e.env.example; set +a
# Then: node tests/helpers/mock-provider.js 4010 &   PORT=3100 node app.js &   node tests/e2e/smoke.js
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=colon_e2e
DB_USER=colon
DB_PASSWORD=change-me
ALLOWED_ORIGINS=http://localhost:8080
APP_SECRET=local-e2e-secret-0123456789abcdef
OWNER_EMAIL=owner@example.com
# Every model slot is served by the mock provider on :4010. No Gemini key, so Gemma runs on NVIDIA as gemma-test.
NVIDIA_API_KEY=x
NVIDIA_BASE_URL=http://127.0.0.1:4010
GROQ_API_KEY=x
GROQ_BASE_URL=http://127.0.0.1:4010
NVIDIA_GEMMA_MODEL=gemma-test
NVIDIA_DEEPSEEK_MODEL=deepseek-test
NVIDIA_MINIMAX_MODEL=minimax-test
NVIDIA_GLM_MODEL=glm-test
GROQ_MODEL=qwen-test
GEMINI_FALLBACK_MODEL=off
# One model at a time, so the first choice in routing is always the one that answers.
AI_HEDGE=1
# The guest daily limit the smoke test runs into on purpose.
CHAT_GUEST_DAILY_LIMIT=5
# Research mode stays offline; tests/e2e/admin.js adds a model that has no benchmark run.
WEB_SEARCH=off
BENCH_GATE=off
